<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.mybatis.example.mapper.UserMapper">

    <insert id="save" parameterType="org.mybatis.example.entity.User">
        insert into t_user(username, password, birthday, gender, email)
        values(#{user.username}, #{user.password}, #{user.birthday}, #{user.gender}, #{user.email})
    </insert>

    <update id="updatePasswordById">
        update t_user set password = #{password} where id = #{userId}
    </update>

    <select id="selectAll" resultType="org.mybatis.example.entity.User">
        select * from t_user;
    </select>

    <select id="selectById" resultType="org.mybatis.example.entity.User">
        select * from t_user where id = #{userId};
    </select>

</mapper>